# 以下为供应商实施配置。普通教师不填写密钥。
# 所有值为 Docker env-file 字面值；不要加 shell 引号或使用变量替换。
# LLM_BASE_URL=https://proxy.example/v1
# LLM_API_KEY=由实施人员私下配置
# LLM_MODEL=经合同验证的模型
# VLM_MODEL=经验证的视觉模型
# SCHOOL_DB_HOST=10.0.0.10
# SCHOOL_DB_PORT=3306
# SCHOOL_DB_USER=training_readonly
# SCHOOL_DB_PASSWORD=由校方安全交付
# SCHOOL_DB_DATABASE=school_training
# SCHOOL_DB_SSL_CA=/data/certs/school-db-ca.pem
# OIDC_ISSUER=https://sso.school.example
# OIDC_CLIENT_ID=training
# OIDC_CLIENT_SECRET=由校方安全交付
# OIDC_REDIRECT_URI=https://training.school.example/api/v1/sso/callback
# CAMERA_ALLOWED_HOSTS=camera.school.example
